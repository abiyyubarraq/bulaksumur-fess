{
  "name": "bulaksumur-fess-bot",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node --format=esm",
    "build:prod": "bun build src/index.ts --outdir=dist --target=node --format=esm --minify",
    "start:prod": "cd dist && bun index.js",
    "lint": "biome lint --diagnostic-level=error .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@grammyjs/transformer-throttler": "^1.2.1",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.3.0",
    "grammy": "^1.36.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "nanoid": "^5.1.5",
    "nodemailer": "^7.0.6"
  }
}
